  {
    "name": "analyze_reference_drawing",
    "description": "只读打开一份真实图纸（不影响、不修改当前正在编辑的文档），提取里面\n        实体的真实空间布局（类型/坐标/包围盒），返回结构化 JSON，供画新图纸前\n        参考真实的间距、朝向、连接线走法。file_path 用 list_reference_drawings\n        返回的路径，或任何本机可访问的 .dwg 文件。可选按 entity_type\n        （如 AcDbLine/AcDbCircle/AcDbBlockReference）过滤。\n        ",
    "inputSchema": {
      "properties": {
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "entity_type": {
          "default": "",
          "title": "Entity Type",
          "type": "string"
        },
        "max_entities": {
          "default": 500,
          "title": "Max Entities",
          "type": "integer"
        }
      },
      "required": [
        "file_path"
      ],
      "title": "analyze_reference_drawingArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "analyze_reference_drawingOutput",
      "type": "object"
    }
  },
  {
    "name": "ask_drawing_vqa",
    "description": "向本地微调的电力工程图纸理解模型提问（针对110kV变电站图纸领域优化，\n        擅长回答设备类型/数量、母线接线方式、电压等级等问题）。image_path 需为本机可访问的\n        图片文件路径（PNG/JPG）。若需要先把当前 AutoCAD 图纸导出成图片，请先用其他工具导出。\n        ",
    "inputSchema": {
      "properties": {
        "image_path": {
          "title": "Image Path",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "image_path",
        "question"
      ],
      "title": "ask_drawing_vqaArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "ask_drawing_vqaOutput",
      "type": "object"
    }
  },
  {
    "name": "bulk_get_block_attributes",
    "description": "批量取多个图块引用的属性。传 object_ids 就只查这些；不传就按 block_name\n        过滤（block_name 也不传就是图纸里所有带属性的图块引用）。返回 JSON：\n        {\"object_id\": {\"tag\": \"value\", ...}, ...}。\n        ",
    "inputSchema": {
      "properties": {
        "object_ids": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Ids"
        },
        "block_name": {
          "default": "",
          "title": "Block Name",
          "type": "string"
        }
      },
      "title": "bulk_get_block_attributesArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "bulk_get_block_attributesOutput",
      "type": "object"
    }
  },
  {
    "name": "bulk_set_block_attributes",
    "description": "批量设置图块属性。updates 是 [{\"object_id\":.., \"tag\":.., \"value\":..}, ...]，\n        单条失败不影响其它条。返回每条的执行结果 JSON。\n        ",
    "inputSchema": {
      "properties": {
        "updates": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Updates",
          "type": "array"
        }
      },
      "required": [
        "updates"
      ],
      "title": "bulk_set_block_attributesArguments",
      "type": "object"
    },
    "outputSchema": {
      "properties": {
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "title": "bulk_set_block_attributesOutput",
      "type": "object"
    }
  },
