[
  {
    "name": "execute_atomic_batch",
    "description": "在显式指定的 HTTP Bridge 自建文档中执行 1–200 项原子操作。\n        仅支持 create_layer/draw_line/draw_circle，坐标使用三元素 WCS 数组；\n        step id 必须唯一，不支持跨步骤动态引用。失败整体回滚，不支持文件操作。\n        返回 request_id、document_id、revision 和逐步结果。COM 明确不支持，无回退。\n        相同 request_id 只在原实例有效窗口内去重；结果未知时用 get_job_status 查询。\n        ",
    "inputSchema": {
      "$defs": {
        "CircleArgs": {
          "additionalProperties": false,
          "properties": {
            "center": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "Center",
              "type": "array"
            },
            "radius": {
              "exclusiveMinimum": 0,
              "title": "Radius",
              "type": "number"
            },
            "layer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Layer"
            }
          },
          "required": [
            "center",
            "radius"
          ],
          "title": "CircleArgs",
          "type": "object"
        },
        "CircleStep": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9._-]{1,128}$",
              "title": "Id",
              "type": "string"
            },
            "operation": {
              "const": "draw_circle",
              "title": "Operation",
              "type": "string"
            },
            "args": {
              "$ref": "#/$defs/CircleArgs"
            }
          },
          "required": [
            "id",
            "operation",
            "args"
          ],
          "title": "CircleStep",
          "type": "object"
        },
        "LayerArgs": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Name",
              "type": "string"
            },
            "color": {
              "anyOf": [
                {
                  "maximum": 255,
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Color"
            }
          },
          "required": [
            "name"
          ],
          "title": "LayerArgs",
          "type": "object"
        },
        "LayerStep": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9._-]{1,128}$",
              "title": "Id",
              "type": "string"
            },
            "operation": {
              "const": "create_layer",
              "title": "Operation",
              "type": "string"
            },
            "args": {
              "$ref": "#/$defs/LayerArgs"
            }
          },
          "required": [
            "id",
            "operation",
            "args"
          ],
          "title": "LayerStep",
          "type": "object"
        },
        "LineArgs": {
          "additionalProperties": false,
          "properties": {
            "start": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "Start",
              "type": "array"
            },
            "end": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "End",
              "type": "array"
            },
            "layer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Layer"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "title": "LineArgs",
          "type": "object"
        },
        "LineStep": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[A-Za-z0-9._-]{1,128}$",
              "title": "Id",
              "type": "string"
            },
            "operation": {
              "const": "draw_line",
              "title": "Operation",
              "type": "string"
            },
            "args": {
              "$ref": "#/$defs/LineArgs"
            }
          },
          "required": [
            "id",
            "operation",
            "args"
          ],
          "title": "LineStep",
          "type": "object"
        }
      },
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "operations": {
          "items": {
            "discriminator": {
              "mapping": {
                "create_layer": "#/$defs/LayerStep",
                "draw_circle": "#/$defs/CircleStep",
                "draw_line": "#/$defs/LineStep"
              },
              "propertyName": "operation"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LineStep"
              },
              {
                "$ref": "#/$defs/CircleStep"
              },
              {
                "$ref": "#/$defs/LayerStep"
              }
            ]
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Operations",
          "type": "array"
        },
        "request_id": {
          "default": "",
          "pattern": "^$|^[A-Za-z0-9._-]{1,128}$",
          "title": "Request Id",
          "type": "string"
        },
        "expected_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision"
        }
      },
      "required": [
        "document_id",
        "operations"
      ],
      "title": "execute_atomic_batchArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "BridgeError": {
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "retryable": {
              "default": false,
              "title": "Retryable",
              "type": "boolean"
            },
            "outcome": {
              "default": "not_executed",
              "title": "Outcome",
              "type": "string"
            },
            "failed_operation_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Failed Operation Id"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "BridgeError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "rolled_back",
            "cancelled",
            "outcome_unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/BridgeError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        }
      },
      "required": [
        "instance_id",
        "request_id",
        "status"
      ],
      "title": "BridgeJob",
      "type": "object"
    }
  },
  {
    "name": "get_backend_status",
    "description": "查询后端生命周期、能力及 HTTP 文档会话。COM 状态查询不隐式启动 CAD；\n        HTTP 返回实例、活动/旧工具绑定文档及 revision。写入前从此处获取 document_id。\n        ",
    "inputSchema": {
      "properties": {},
      "title": "get_backend_statusArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "backend": {
          "enum": [
            "com",
            "http"
          ],
          "title": "Backend",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "capabilities": {
          "additionalProperties": true,
          "title": "Capabilities",
          "type": "object"
        },
        "documents": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Documents",
          "type": "array"
        },
        "connection_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Connection State"
        },
        "queue_depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Depth"
        },
        "instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Instance Id"
        },
        "active_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Document Id"
        },
        "bound_document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bound Document Id"
        },
        "cad_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cad Version"
        },
        "revision_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision Mode"
        }
      },
      "required": [
        "backend",
        "state",
        "capabilities",
        "documents"
      ],
      "title": "BackendStatus",
      "type": "object"
    }
  },
  {
    "name": "get_job_status",
    "description": "查询 HTTP Bridge 请求状态。写入结果未知时只查询该 request_id，不自动重放；\n        journal 仅在当前实例的有界保留窗口内有效，JOB_NOT_FOUND 不证明写入从未执行。\n        ",
    "inputSchema": {
      "properties": {
        "request_id": {
          "pattern": "^[A-Za-z0-9._-]{1,128}$",
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "get_job_statusArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "BridgeError": {
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            },
            "retryable": {
              "default": false,
              "title": "Retryable",
              "type": "boolean"
            },
            "outcome": {
              "default": "not_executed",
              "title": "Outcome",
              "type": "string"
            },
            "failed_operation_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Failed Operation Id"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "title": "BridgeError",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "rolled_back",
            "cancelled",
            "outcome_unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "result": {
          "default": null,
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/BridgeError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metrics"
        }
      },
      "required": [
        "instance_id",
        "request_id",
        "status"
      ],
      "title": "BridgeJob",
      "type": "object"
    }
  },
  {
    "name": "query_entities_page",
    "description": "分页查询显式 HTTP 文档，支持类型、图层和字段裁剪。身份字段始终包含。\n        每页最多 1000 项；继续查询须保留相同 document_id/过滤/fields/limit 并传 next_cursor。\n        游标绑定实例、文档和观察到的 revision，图纸变化或游标过期后需从第一页重读。\n        旧 query_entities 签名及 1000 项限制保持不变；COM 暂不支持此分页接口。\n        ",
    "inputSchema": {
      "properties": {
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Document Id",
          "type": "string"
        },
        "entity_type": {
          "default": "",
          "maxLength": 128,
          "title": "Entity Type",
          "type": "string"
        },
        "layer": {
          "default": "",
          "maxLength": 255,
          "title": "Layer",
          "type": "string"
        },
        "fields": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "object_id",
                  "type",
                  "layer",
                  "handle",
                  "start_point",
                  "end_point",
                  "center",
                  "radius",
                  "bounding_box"
                ],
                "type": "string"
              },
              "maxItems": 9,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fields"
        },
        "limit": {
          "default": 200,
          "maximum": 1000,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "cursor": {
          "default": "",
          "maxLength": 2048,
          "title": "Cursor",
          "type": "string"
        }
      },
      "required": [
        "document_id"
      ],
      "title": "query_entities_pageArguments",
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "items": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1000,
          "title": "Items",
          "type": "array"
        },
        "count": {
          "maximum": 1000,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "has_more": {
          "title": "Has More",
          "type": "boolean"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "unsupported_geometry_types": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Geometry Types",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "revision",
        "items",
        "count",
        "has_more",
        "next_cursor"
      ],
      "title": "EntityPage",
      "type": "object"
    }
  }
]
